{
  "name": "nannai-confeitaria-e-padaria",
  "private": true,
  "version": "1.8.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "build:production": "tsc -b && vite build --mode production",
    "build:capacitor": "cross-env VITE_BUILD_TARGET=capacitor tsc -b && cross-env VITE_BUILD_TARGET=capacitor vite build --mode production",
    "build:electron": "cross-env VITE_BUILD_TARGET=electron tsc -b && cross-env VITE_BUILD_TARGET=electron vite build --mode production",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "start:production": "npm run start --prefix server",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "npm run build:capacitor && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron electron/main.cjs\"",
    "electron:build": "npm run build:electron && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/network": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.9",
    "axios": "^1.18.1",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "niimbot-web-bluetooth": "^1.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "br.com.nannai.foodops",
    "productName": "NANNAI Food Operations",
    "directories": {
      "output": "release/electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/icon-256.png"
    }
  }
}
