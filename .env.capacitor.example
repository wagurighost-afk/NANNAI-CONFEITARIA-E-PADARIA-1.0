# NANNAI — variáveis para build Capacitor (Android / iOS)
# Copie para .env.capacitor.local e ajuste a URL da API em produção.

VITE_BUILD_TARGET=capacitor
VITE_API_BASE_URL=https://SEU-DOMINIO.onrender.com/api
VITE_CLOUD_API_URL=https://SEU-DOMINIO.onrender.com/api
VITE_APP_NAME=NANNAI Confeitaria e Padaria
VITE_SYSTEM_NAME=Food Operations Management System
VITE_USE_MOCK=false
